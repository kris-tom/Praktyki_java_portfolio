				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AgLe">
				<xs:annotation>
					<xs:documentation>Agnieszka Lejman</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GrRu">
				<xs:annotation>
					<xs:documentation>Grzegorz Rutkowski</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="KaŚl">
				<xs:annotation>
					<xs:documentation>Kacper Ślipko</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MaJa">
				<xs:annotation>
					<xs:documentation>Magdalena Jakubowska</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MaKa">
				<xs:annotation>
					<xs:documentation>Małgorzata Kasperczak</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MiKu">
				<xs:annotation>
					<xs:documentation>Mirella Kurek-Wardyn</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WaDr">
				<xs:annotation>
					<xs:documentation>Waldemar Drapikowski</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="KoSz">
				<xs:annotation>
					<xs:documentation>Konrad Szymański</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ZyKo">
				<xs:annotation>
					<xs:documentation>Zygmunt Komański</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MaSa">
				<xs:annotation>
					<xs:documentation>Marzena Sapkowska</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ArAd">
				<xs:annotation>
					<xs:documentation>Artur Adam</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MaAd">
				<xs:annotation>
					<xs:documentation>Maciej Adamczak</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MaDr">
				<xs:annotation>
					<xs:documentation>Marta Drozdowska</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AnJe">
				<xs:annotation>
					<xs:documentation>Aneta Jerzycka</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SePa">
