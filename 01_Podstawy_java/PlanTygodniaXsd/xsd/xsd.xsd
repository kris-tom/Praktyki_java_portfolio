					<xs:documentation>Sebastian Paprzycki</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>

	
	<xs:complexType name="lessonContent">
		<xs:sequence>
			<xs:element name="subject" type="xs:string" />
			<xs:element name="teacher" type="tns:typeTeacher" />
			<xs:element name="fromTo" type="xs:string" />
		</xs:sequence>
	</xs:complexType>

	
	<xs:element name="lesson" type="tns:lessonContent" />
	<xs:element name="break" type="tns:lessonContent" />
	<xs:element name="substitute" type="tns:lessonContent" />
	<xs:element name="freeoflessons" type="tns:lessonContent" />

	
	<xs:element name="dayofTheweek">
		<xs:complexType>
			<xs:sequence>
				<xs:choice maxOccurs="9">
					<xs:element ref="tns:lesson" />
					<xs:element ref="tns:break" />
					<xs:element ref="tns:substitute" />
					<xs:element ref="tns:freeoflessons" />
				</xs:choice>
			</xs:sequence>
			<xs:attribute name="datetime" type="xs:date" use="optional" />
			<xs:attribute name="name" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>

	
	<xs:element name="schedule">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="tns:dayofTheweek" maxOccurs="5" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

</xs:schema>